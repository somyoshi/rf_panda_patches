# =====================================================================
#  Repositorio do auto-update do RF PANDA.
#  Tudo fica FORA do Git, menos o que esta liberado com "!" abaixo.
#  Essa lista precisa bater com a do launcher (UpdateMgr.cpp).
# =====================================================================

# 1) ignora tudo da raiz do client
/*

# 2) libera o que vai para o auto-update
!/.gitignore
!/.gitattributes
!/manifest.json
!/RFPandaLauncher.exe
!/Qt6*.dll
!/sirin-launcher.dll
!/d3d9.dll
!/DataTable/
!/SpriteImage/
!/Effect/
!/launcher/
!/platforms/
!/styles/
!/imageformats/
!/tls/
!/networkinformation/
!/generic/
!/iconengines/
# modelos 3D dos shields novos (57-67). So a pasta Shield; o resto de item/ vem pelo instalador
!/item/
/item/*
!/item/Shield/
# armas premium Venore: so os pacotes novos e os RFSInfo.dat de item/Weapon
!/item/Weapon/
/item/Weapon/*
!/item/Weapon/Mesh/
!/item/Weapon/Tex/
/item/Weapon/Mesh/*
/item/Weapon/Tex/*
!/item/Weapon/Mesh/RFSInfo.dat
!/item/Weapon/Tex/RFSInfo.dat
!/item/Weapon/Mesh/VNR*.RFS
!/item/Weapon/Tex/VNR*.RFS
# armaduras Dragon (Red/Black/Gold): so os pacotes novos e os RFSInfo.dat de Character/Player
!/Character/
/Character/*
!/Character/Player/
/Character/Player/*
!/Character/Player/Mesh/
!/Character/Player/Tex/
/Character/Player/Mesh/*
/Character/Player/Tex/*
!/Character/Player/Mesh/RFSInfo.dat
!/Character/Player/Tex/RFSInfo.dat
!/Character/Player/Mesh/VNR*.RFS
!/Character/Player/Tex/VNR*.RFS
# HQ da Accretia: so o NeutralA.ebp (barraca trade_ac tirada do mapa, 13/10/2026)
!/Map/
/Map/*
!/Map/neutralA/
/Map/neutralA/*
!/Map/neutralA/NeutralA.ebp
# COB (Cartella Old Base): so o accretia.ebp (chao trocado pelo do RF Banana, 21/10/2026)
!/Map/accretia/
/Map/accretia/*
!/Map/accretia/accretia.ebp

# 3) dentro dessas pastas, arquivos que o jogo/jogador altera ou backups
/DataTable/GameSetting.ini
/DataTable/clientdb.dat
# teclas do jogador (cada um configura as suas)
/DataTable/*/KeyMap.dat
/DataTable/*/KeyMap_NKM.dat
/launcher/cache/
*.old
*.part
*_.edf
*_.spr
Thumbs.db
desktop.ini
# arquivos de desenvolvimento (backups, patches e scripts) nunca vao para o jogador
*.bak
*.bak_*
*.patch
*.bat
*.ps1
# lixo de testes antigos dos shields (caso ainda exista)
/item/Shield/Mesh/*_17[6-9].msh
/item/Shield/Mesh/*_180.msh
/item/Shield/Tex/VNR_*.dds
/item/Shield/Tex/VNRSHT.RFS
/item/Shield/Tex/VNRT01.RFS
/item/Shield/Tex/VNRT04.RFS
/item/Shield/Tex/VNRT06.RFS
/item/Shield/Tex/VNRT08.RFS
/item/Shield/Tex/VNRT10.RFS
